# ============================================================
# 微信公众号发布器配置
# ============================================================

# 微信公众号配置（必填）
WECHAT_APP_ID=你的AppID
WECHAT_APP_SECRET=你的AppSecret

# ============================================================
# 以下配置均不需要填写，自动使用 OpenClaw 内置能力
# ============================================================

# 图片生成：自动使用 OpenClaw 内置的 glm-image
# 无需配置 API Key

# 图床存储：可选
# MINIO_ENDPOINT=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=

# 推送通知：可选
# PUSHDEER_KEY=
